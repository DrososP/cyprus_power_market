# Copy to secrets.toml locally, or paste into Streamlit Community Cloud under
# App settings -> Secrets. Never commit the real file — .gitignore excludes it.
#
# Leaving this out entirely is fine: the dashboard only enables its login gate
# when an [auth] section exists, so local development stays open.

allowed_emails = [
  "drosos.papaeracleous@gmail.com",
  # add each person who should be able to sign in
]

[auth]
# Your deployed app's URL with /oauth2callback on the end.
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "CHANGE-ME"

client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
